# {{ inventory_hostname }}: one port per rail (eth1 = Leaf1 ... eth5 = Leaf5).
# Generated by Ansible - do not edit by hand.
network:
  version: 2
  ethernets:
{% for rail in range(1, 6) %}
    eth{{ rail }}:
      optional: true
      addresses: [10.{{ rail }}.{{ server_id }}.2/30]
      routes:
        - to: 10.{{ rail }}.0.0/16
          via: 10.{{ rail }}.{{ server_id }}.1
        - to: 10.0.0.0/8
          via: 10.{{ rail }}.{{ server_id }}.1
          table: {{ 100 + rail }}
      routing-policy:
        - from: 10.{{ rail }}.{{ server_id }}.2
          table: {{ 100 + rail }}
          priority: {{ 100 + rail }}
{% endfor %}
